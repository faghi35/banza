# ============================================================
# Banza AI — Backend Node.js/Express (LOCAL)
# Copier vers .env puis remplir les valeurs.
# NE JAMAIS COMMITTER ce fichier.
# ============================================================

NODE_ENV=development
PORT=3000

# Origine autorisée du frontend (CORS)
FRONTEND_URL=http://localhost:5173

# --- Base de données MySQL / MariaDB (XAMPP local) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=banza_ai

# --- NVIDIA LLM ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct