# Banza AI Frontend — PRODUCTION (Vercel)
# ============================================================
# L'API est appelée en URLs RELATIVES (/api/...) et relayée par
# next.config.mjs (rewrites → BACKEND_ORIGIN) vers le backend PHP.
# Ne mettez JAMAIS d'URL absolue ici.
NEXT_PUBLIC_API_URL=

# Origine du backend PHP utilisee par le proxy cote serveur
# (variable NON-publique, lisible uniquement au build/serveur Next).
# Surcharge la valeur par defaut de next.config.mjs en production.
BACKEND_ORIGIN=http://banza-ai.hopetrade-rdc.com